<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="24dp"
    android:layout_marginTop="24dp"
    android:layout_marginEnd="24dp"
    android:layout_marginBottom="24dp"
    tools:context=".CameraActivity">

    <TextView
        android:id="@+id/submenu3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="카메라 인식률"
        android:textSize="20dp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/accuracy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="0%"
        android:textSize="20dp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/submenu3"
        app:layout_constraintTop_toBottomOf="@+id/submenu3" />

    <TextView
        android:id="@+id/alert"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="주의 문구"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@+id/accuracy"
        app:layout_constraintTop_toBottomOf="@+id/accuracy" />

    <VideoView
        android:id="@+id/liveCamera"
        android:layout_width="364dp"
        android:layout_height="185dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@+id/alert"
        app:layout_constraintTop_toBottomOf="@+id/alert" />


</androidx.constraintlayout.widget.ConstraintLayout>