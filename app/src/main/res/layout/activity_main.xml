<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/AlarmButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="right"
            android:layout_marginTop="20dp"
            android:layout_marginRight="20dp"
            app:srcCompat="@drawable/ic_alarm_bell" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="50dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/driver_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NAME"
                android:textColor="@color/blue"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:text=" 님"
                android:textColor="@color/black"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:layout_editor_absoluteX="102dp"
                tools:layout_editor_absoluteY="72dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="의 운전 점수는"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:layout_editor_absoluteX="102dp"
                tools:layout_editor_absoluteY="72dp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="30dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/driver_score_bar"
                android:layout_width="340dp"
                android:layout_height="100dp"
                android:max="100"
                android:progress="0"
                app:indicatorColor="@color/blue"
                app:indicatorSize="220dp"
                app:trackCornerRadius="10dp"
                app:trackThickness="20dp" />

            <TextView
                android:id="@+id/driver_score"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/blue"
                android:textSize="64sp"
                android:textStyle="bold" />
        </FrameLayout>

    </LinearLayout>

    <TableLayout
        android:id="@+id/tableLayout"
        android:layout_width="0dp"
        android:layout_height="300dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TableRow
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_manage_profile"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:outlineProvider="none"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:text="개인 정보 관리"
                android:textColor="@color/btn_text_selector"
                app:backgroundTint="@color/btn_bg_selector"
                app:cornerRadius="20dp"
                app:icon="@drawable/icon_person"
                app:iconGravity="top"
                app:iconPadding="0dp"
                app:iconSize="50dp"
                app:iconTint="@color/btn_text_selector"
                app:strokeColor="@color/blue"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_manage_vehicle"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:outlineProvider="none"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:text="차량 관리"
                android:textColor="@color/btn_text_selector"
                app:backgroundTint="@color/btn_bg_selector"
                app:cornerRadius="20dp"
                app:elevation="0dp"
                app:icon="@drawable/icon_car"
                app:iconGravity="top"
                app:iconPadding="0dp"
                app:iconSize="50dp"
                app:iconTint="@color/btn_text_selector"
                app:strokeColor="@color/blue"
                app:strokeWidth="1dp" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_drive_history"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:outlineProvider="none"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:text="나의 운전 기록"
                android:textColor="@color/btn_text_selector"
                app:backgroundTint="@color/btn_bg_selector"
                app:cornerRadius="20dp"
                app:icon="@drawable/icon_drivelog"
                app:iconGravity="top"
                app:iconPadding="0dp"
                app:iconSize="50dp"
                app:iconTint="@color/btn_text_selector"
                app:strokeColor="@color/blue"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_emergency_guide"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:outlineProvider="none"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:text="사고발생 대처요령"
                android:textColor="@color/btn_text_selector"
                app:backgroundTint="@color/btn_bg_selector"
                app:cornerRadius="20dp"
                app:icon="@drawable/icon_siren"
                app:iconGravity="top"
                app:iconPadding="0dp"
                app:iconSize="50dp"
                app:iconTint="@color/btn_text_selector"
                app:strokeColor="@color/blue"
                app:strokeWidth="1dp" />
        </TableRow>

    </TableLayout>

    <Button
        android:id="@+id/logoutBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/btn_text_selector"
        android:text="로그아웃"
        app:cornerRadius="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/blue"
        app:strokeWidth="1dp" />
</androidx.constraintlayout.widget.ConstraintLayout>